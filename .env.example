# Integral del Este — desarrollo local sin Docker (copiar a .env)
APP_ENV=desarrollo
APP_DEBUG=1
TZ=America/Argentina/Buenos_Aires

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=integral
DB_USER=integral_app
DB_PASSWORD=app_local
DB_BACKUP_PASSWORD=backup_local
DB_OWNER_USER=integral
DB_OWNER_PASSWORD=integral

SESSION_IDLE_MINUTES=15
ARCA_MODO=simulado
MAIL_MODO=archivo
MAIL_FROM=sistema@integraldeleste.com.ar
