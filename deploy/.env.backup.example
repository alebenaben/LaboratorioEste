# Integral del Este — copias de seguridad (copiar a .env.backup; chmod 600)
# Bucket S3 compatible en OTRO proveedor (Backblaze B2 o Cloudflare R2) con bloqueo de objetos de 30 días.
RESTIC_REPOSITORY=s3:https://s3.us-west-004.backblazeb2.com/integral-copias/integral
AWS_ACCESS_KEY_ID=clave-de-acceso-del-bucket
RESTIC_CACHE_DIR=/cache

DB_HOST=db
DB_NAME=integral
DB_USER=integral_backup

# Cada 6 horas (00, 06, 12 y 18 h). Formato: horas separadas por coma.
BACKUP_HORAS=0,6,12,18
BACKUP_RETENTION=--keep-last 4 --keep-daily 14 --keep-weekly 8 --keep-monthly 24

# Aviso al monitoreo (si falla se llama a la misma URL con /fail)
HEARTBEAT_BACKUP_URL=
TZ=America/Argentina/Buenos_Aires
