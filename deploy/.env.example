# Integral del Este — variables NO secretas (copiar a .env y completar; chmod 600 .env)
# Los secretos van en archivos dentro de deploy/secrets/ (ver docs/INSTALACION.md).

# Dominio público y correo para los avisos de Let's Encrypt (Caddy)
DOMINIO=sistema.integraldeleste.com.ar
EMAIL_ACME=sistemas@integraldeleste.com.ar
PUBLIC_URL=https://sistema.integraldeleste.com.ar

# Versión de la imagen que se construye y despliega
APP_TAG=1.0.0

# produccion | demo (demo habilita "Volver a cargar el padrón")
APP_ENV=produccion
TZ=America/Argentina/Buenos_Aires

# Base de datos (la aplicación usa el rol integral_app)
DB_HOST=db
DB_PORT=5432
DB_NAME=integral
DB_USER=integral_app

# Sesión: se cierra a los 15 minutos sin actividad
SESSION_IDLE_MINUTES=15
COOKIE_SECURE=1
TRUST_PROXY=1

# ARCA: simulado | homologacion | produccion
ARCA_MODO=homologacion
ARCA_CUIT=30716447495

# Mail: smtp | archivo | desactivado
MAIL_MODO=smtp
MAIL_FROM=sistema@integraldeleste.com.ar
MAIL_FROM_NAME=Integral del Este
MAIL_REPLY_TO=administracion@integraldeleste.com.ar
SMTP_HOST=smtp.proveedor.com
SMTP_PORT=587
SMTP_USER=sistema@integraldeleste.com.ar

# Monitoreo externo (Healthchecks.io u otro): el worker avisa cada 5 minutos
HEARTBEAT_WORKER_URL=
